				{
					"name": "login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Extract JWT token from login response",
									"if (pm.response.code === 200) {",
									"    try {",
									"        const jsonData = pm.response.json();",
									"        ",
									"        // Try different possible response formats",
									"        let token = jsonData.token || jsonData.accessToken || jsonData.access_token || jsonData.data?.token;",
									"        ",
									"        if (token) {",
									"            pm.collectionVariables.set('authToken', token);",
									"            console.log('JWT token saved successfully');",
									"            ",
									"            // Decode JWT to show user info",
									"            try {",
									"                const base64Url = token.split('.')[1];",
									"                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');",
									"                const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {",
									"                    return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);",
									"                }).join(''));",
									"                const payload = JSON.parse(jsonPayload);",
									"                console.log('Token payload:', payload);",
									"                ",
									"                // Save user info if available",
									"                if (payload.userId) pm.collectionVariables.set('userId', payload.userId);",
									"                if (payload.companyId) pm.collectionVariables.set('companyId', payload.companyId);",
									"                if (payload.email) pm.collectionVariables.set('userEmail', payload.email);",
									"            } catch (e) {",
									"                console.log('Could not decode JWT:', e.message);",
									"            }",
									"        } else {",
									"            console.log('No token found in response');",
									"            console.log('Response:', jsonData);",
									"        }",
									"    } catch (e) {",
									"        console.log('Error parsing response:', e.message);",
									"    }",
									"} else {",
									"    console.log('Login failed with status:', pm.response.code);",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}",
								"type": "text"
							}
